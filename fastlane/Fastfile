# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do

  desc "Get the Projects current Build Number"
  lane :current_build_number do
    build_number = get_build_number(xcodeproj: "Glider Tool.xcodeproj")
  end
  
  
  desc "Get TestFlights current Build Number"
  lane :current_testflight_build_number do
    latest_testflight_build_number
  end 

  desc "Increment the Projects Build Number"
  lane :increment_project_build_number do
    increment_build_number(xcodeproj: "Glider Tool.xcodeproj")
  end

  desc "Build a new Beta and push it to TestFlight"
  lane :new_beta do
    #get_certificates           # invokes cert
    #get_provisioning_profile   # invokes sigh
    build_app(workspace: "Glider Tool.xcworkspace", scheme: "Glider Tool")
    upload_to_testflight
  end
  
end